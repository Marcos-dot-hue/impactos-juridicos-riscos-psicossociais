    {
      "parameters": {
        "jsCode": "// Máquina de estados: valida transição solicitada\nconst webhookData = $('Webhook Atualização').item.json.body;\nconst registroAtual = $input.item.json;\n\nconst statusAtual = registroAtual.status;\nconst novoStatus = webhookData.novo_status;\n\nconst transicoesPermitidas = {\n  \"Recebido\": [\"Em Investigação\", \"Descartado\"],\n  \"Em Investigação\": [\"Aguardando Evidências\", \"Encerrado\", \"Improcedente\"],\n  \"Aguardando Evidências\": [\"Em Investigação\", \"Encerrado\", \"Improcedente\"],\n  \"Encerrado\": [],\n  \"Improcedente\": [],\n  \"Descartado\": []\n};\n\nconst permitidas = transicoesPermitidas[statusAtual] || [];\nconst transicaoValida = permitidas.includes(novoStatus);\n\nif (!transicaoValida) {\n  return {\n    json: {\n      erro: true,\n      caso_id: webhookData.caso_id,\n      motivo: `Transição inválida: ${statusAtual} → ${novoStatus}`,\n      status_atual: statusAtual\n    }\n  };\n}\n\nreturn {\n  json: {\n    erro: false,\n    caso_id: webhookData.caso_id,\n    row_number: registroAtual.row_number,\n    status_anterior: statusAtual,\n    status_novo: novoStatus,\n    responsavel: webhookData.responsavel || \"Não informado\",\n    resumo_tratativa: webhookData.resumo_tratativa || \"\",\n    data_movimentacao: new Date().toISOString()\n  }\n};"
      },
